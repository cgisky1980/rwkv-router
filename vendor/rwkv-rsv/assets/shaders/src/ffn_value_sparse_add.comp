#version 450 core
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_EXT_buffer_reference : enable
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_atomic_float : require

// 稀疏 FFN value 投影：x += r2 @ ffn_value（r2=relu² 输出，约 96% 稀疏）。
// 对标 CUDA `ffn_value_sparse_add`：只读 r2 非零列的权重，把全量 50MiB 读取降到 ~2MiB。
//
// 每个 workgroup 处理一个 (f_block, c_block)：
//   - f_block：TILE=128 个 f（r2 的一段）
//   - c_block：C_TILE=256 个 c（x 的一段）
// 流程：
//   1. 读 r2 片到 shared，用 shared int 原子统计非零并收集 nnz_ids（96% 稀疏，冲突可忽略）。
//   2. 遍历非零 f，只读 `value_tiled` 中对应列的 fp16 权重，累加对本线程 (c_local, c_local+1)。
//   3. atomicAdd 到 x（跨 (f_block) 累加，VK_EXT_shader_atomic_float 的 buffer fp32 原子）。
//
// value_tiled 布局（对齐 Albatross / CUDA）：
//   [f_block][c_block][f_local][c_local]，元素 (f,c) → ((f_block*c_blocks+c_block)*TILE)*C_TILE
//   + f_local*C_TILE + c_local。该布局使「固定 f、连续 c」读取命中合并访问。

layout(constant_id = 0) const uint C = 4096;        // 通道数
layout(constant_id = 1) const uint FH = 10240;      // FFN hidden
layout(constant_id = 2) const uint TILE = 128;      // f 块大小
layout(constant_id = 3) const uint C_TILE = 256;    // c 块大小

const uint BLOCK_SIZE = 128;   // == TILE

shared float r2_slice[TILE];
shared int   nnz_ids[TILE];
shared int   nnz_count;

layout(buffer_reference) buffer BufR2 { float data[]; } buf_r2;   // [fh]，relu² 输出
layout(buffer_reference) buffer BufW  { uint  data[]; } buf_w;    // [fh*C] fp16 平铺（每 uint 2 个 fp16）
layout(buffer_reference) buffer BufX  { float data[]; } buf_x;    // [C]，就地原子累加（已含残差）

layout(set = 0, binding = 0, std430) uniform Params {
    BufR2 buf_r2;
    BufW  buf_w;
    BufX  buf_x;
} params;

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint f_block = gl_WorkGroupID.x;   // 范围 [0, FH/TILE)
    const uint c_block = gl_WorkGroupID.y;   // 范围 [0, C/C_TILE)
    const uint tid     = gl_LocalInvocationID.x;
    const uint start_f = f_block * TILE;

    BufR2 buf_r2 = params.buf_r2;
    BufW  buf_w  = params.buf_w;
    BufX  buf_x  = params.buf_x;

    if (tid == 0) {
        nnz_count = 0;
    }
    barrier();

    // 读 r2 片并统计非零（r2 已 relu²，非零即 != 0）。
    if (tid < TILE) {
        const float r2v = buf_r2.data[start_f + tid];
        r2_slice[tid] = r2v;
        if (r2v != 0.0) {
            const int pos = atomicAdd(nnz_count, 1);
            nnz_ids[pos] = int(tid);
        }
    }
    barrier();

    const uint c_blocks   = C / C_TILE;
    const uint tile_base  = ((f_block * c_blocks + c_block) * TILE) * C_TILE;
    const uint c_local0   = tid * 2;                       // 本线程负责的 c 对起点（C_TILE 内）
    const uint c0         = c_block * C_TILE + c_local0;   // 全局 c 索引

    float acc0 = 0.0;
    float acc1 = 0.0;
    const int num = nnz_count;
    for (int i = 0; i < num; i += 2) {
        const int f0 = nnz_ids[i];
        const uint w_ofs = tile_base + uint(f0) * C_TILE + c_local0;
        const float a0 = r2_slice[uint(f0)];
        const vec2 wv0 = unpackFloat2x16(buf_w.data[w_ofs >> 1]);
        acc0 += a0 * wv0.x;
        acc1 += a0 * wv0.y;
        if (i + 1 < num) {
            const int f1 = nnz_ids[i + 1];
            const uint w_ofs1 = tile_base + uint(f1) * C_TILE + c_local0;
            const float a1 = r2_slice[uint(f1)];
            const vec2 wv1 = unpackFloat2x16(buf_w.data[w_ofs1 >> 1]);
            acc0 += a1 * wv1.x;
            acc1 += a1 * wv1.y;
        }
    }

    // 跨 f_block 累加：buffer 级 fp32 原子（VK_EXT_shader_atomic_float）。
    atomicAdd(buf_x.data[c0], acc0);
    atomicAdd(buf_x.data[c0 + 1], acc1);
}